{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "all"]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".ref/**", "packages/pi-agents/**"]
}